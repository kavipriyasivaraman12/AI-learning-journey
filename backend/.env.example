# Application Settings
PROJECT_NAME="AI-Driven Individualized Learning Journey Generator"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL with psycopg v3)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/ai_learning_db"

# JWT Security Configuration
SECRET_KEY="dev_secret_key_change_in_production_min_32_chars_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI API Configuration (Keep empty or fill when key is obtained)
GEMINI_API_KEY=""

# Allowed CORS Origins (JSON list format)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
